# Development API proxy target (used by the Astro dev server)
API_PROXY_TARGET=http://localhost:9090

# Production API upstream (used by the unprivileged nginx container)
API_UPSTREAM=http://localhost:9090

# Dev server port
PORT=4321

# Optional: call the API on another origin instead of the same-origin /api prefix.
# Only PUBLIC_-prefixed variables reach the browser bundle.
# PUBLIC_API_URL=http://localhost:9090/api
