# Development API Proxy target (used by Astro dev server and Docker dev container)
API_PROXY_TARGET=http://localhost:9090

# Production API Upstream (used by unprivileged Nginx container)
API_UPSTREAM=http://localhost:9090

# Dev server port
PORT=4321

# Test credentials
VITE_TEST_EMAIL=admin@gym.com
VITE_TEST_PASSWORD=admin123
