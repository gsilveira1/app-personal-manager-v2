---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="Página Não Encontrada">
  <main class="min-h-screen flex flex-col items-center justify-center p-4 text-center">
    <h1 class="text-6xl font-extrabold text-indigo-600 mb-4">404</h1>
    <h2 class="text-2xl font-bold text-slate-800 mb-2">Página não encontrada</h2>
    <p class="text-slate-600 mb-6 max-w-md">
      A página que você está procurando pode ter sido removida, renomeada ou está temporariamente indisponível.
    </p>
    <a
      href="/"
      class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors"
    >
      Voltar para o início
    </a>
  </main>
</BaseLayout>
